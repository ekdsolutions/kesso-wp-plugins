# --- Banner content ---
msgid "We use cookies"
msgstr "אנו משתמשים בעוגיות"

msgid "We use cookies to enhance your browsing experience, serve personalized content, and analyze our traffic. By clicking \"Accept All\", you consent to our use of cookies."
msgstr "אנו משתמשים בעוגיות כדי לשפר את חוויית הגלישה, להציג תוכן מותאם אישית ולנתח את התנועה באתר. בלחיצה על \"אשר הכל\" אתם מסכימים לשימוש בעוגיות."

msgid "Accept All"
msgstr "אשר הכל"

msgid "Reject All"
msgstr "דחה הכל"

msgid "Customize"
msgstr "התאמה אישית"

msgid "Save Preferences"
msgstr "שמור העדפות"

msgid "Privacy Policy"
msgstr "מדיניות פרטיות"

# --- Preferences modal ---
msgid "Cookie Preferences"
msgstr "העדפות עוגיות"

msgid "Close"
msgstr "סגור"

msgid "Essential Cookies"
msgstr "עוגיות חיוניות"

msgid "These cookies are necessary for the website to function and cannot be disabled."
msgstr "עוגיות אלו הכרחיות לפעולת האתר ולא ניתן לבטל אותן."

msgid "Analytics Cookies"
msgstr "עוגיות אנליטיקה"

msgid "These cookies help us understand how visitors interact with our website by collecting and reporting aggregated statistical information."
msgstr "עוגיות אלו עוזרות לנו להבין כיצד מבקרים משתמשים באתר, על ידי איסוף ודיווח של מידע סטטיסטי מצטבר."

msgid "Marketing Cookies"
msgstr "עוגיות שיווק"

msgid "These cookies are used to deliver advertisements and track campaign effectiveness."
msgstr "עוגיות אלו משמשות להצגת פרסומות ומעקב אחר יעילות הקמפיינים."

# --- Floating settings link ---
msgid "Cookie Settings"
msgstr "הגדרות עוגיות"

# --- Credit ---
msgid "🧀 Powered by"
msgstr "🧀 מופעל על ידי"

msgid "kesso-cookies plugin"
msgstr "תוסף kesso-cookies"

# --- Preferences modal trust line ---
#, php-format
msgid "Your choices are saved for %d days. You can change them anytime."
msgstr "הבחירות שלכם נשמרות למשך %d ימים. ניתן לשנות אותן בכל עת."
